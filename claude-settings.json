{
  "env": {
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "workflowKeywordTriggerEnabled": false,
  "statusLine": {
    "type": "command",
    "command": "printf '%s@\\033[95m%s\\033[0m:\\033[34m%s\\033[0m \\033[36m%s\\033[0m\\n' \"$(whoami)\" \"$(hostname -s)\" \"$(pwd)\" \"$(git branch --show-current 2>/dev/null | sed 's/^/(/;s/$/)/' || echo '')\""
  },
  "tui": "default",
  "theme": "custom:kanso-pearl"
}
